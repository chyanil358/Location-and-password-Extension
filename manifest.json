{
  "manifest_version": 3,
  "name": "Location + Password Demo",
  "version": "1.0.0",
  "description": "Demo extension for location and form capture",
  "permissions": [
   "storage",
   "activeTab",
   "scripting",
   "geolocation"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}